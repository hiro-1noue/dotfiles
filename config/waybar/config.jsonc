{
	"layer": "top",
	"position": "right",
  "width": 36,
	"height": 0,
	"modules-left": ["hyprland/workspaces"],
	"modules-right": ["pulseaudio", "battery", "network", "clock"],

	"hyprland/workspaces": {
		"format": "{id}"
	},
  "clock": {
    "format": "{:%H\n%M}",
    "tooltip-format": "{:%Y-%m-%d %A}",
    "interval": 10
  },
  "battery": {
		"format": "{capacity}",
    "states": {
      "warning": 20,
      "critical": 10
    }
	},
  "network": {
    "format-wifi": "{icon}",
    "format-icons": {
      "wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
      "ethernet": ["󰈀"],
      "disconnected": ["󰤭"]
    },
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
    "interval": 5
  },
  "pulseaudio": {
    "format": "VOL",
    "format-muted": "MUTE",
    "tooltip-format": "{volume}%",
    "on-click": "pavucontrol",
    "scroll-step": 5
  }
}
